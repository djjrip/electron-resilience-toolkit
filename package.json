{
    "name": "electron-resilience-toolkit",
    "version": "1.0.0",
    "description": "Lightweight monitoring toolkit for Node.js/Electron applications",
    "main": "index.js",
    "scripts": {
        "watchdog": "node watchdog/process-monitor.js",
        "heap": "node --expose-gc watchdog/heap-monitor.js",
        "gate": "ts-node ci-cd/truth-gate.ts",
