        "express": "^4.18.2",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "jest": "^29.7.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}